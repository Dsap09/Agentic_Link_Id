# === AI Digital Product Generator ===
# Copy file ini menjadi .env dan isi dengan value yang benar.
# JANGAN commit file .env ke repository!

# Telegram Bot Token (Wajib)
# Dapatkan dari: https://t.me/BotFather (perintah /newbot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Text AI Providers (Wajib minimal 1)
# Primary: Google Gemini API (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Fallback Text Providers (Opsional — untuk automatic failover jika Gemini 429)
# Groq: https://console.groq.com/ (Gratis, unlimited, Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter: https://openrouter.ai/ (Gratis 50 req/hari)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Hugging Face: https://huggingface.co/settings/tokens (Gratis 1000 req/hari)
HF_API_KEY=your_hf_api_key_here
